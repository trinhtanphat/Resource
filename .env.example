# Cloudflare API token used only for bucket administration through Wrangler.
CLOUDFLARE_API_TOKEN=

# R2 S3 credentials scoped to Object Read & Write for ddtank-resource.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public custom domain or temporary r2.dev URL, without a trailing slash.
R2_PUBLIC_BASE_URL=

# images is the safe default. Use full-resource only after reviewing r2:plan output.
R2_PROFILE=images

# Required only for r2:sync because sync can remove remote-only objects.
R2_ALLOW_DELETE=0
