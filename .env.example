# Cloudflare API token used only for bucket administration through Wrangler.
CLOUDFLARE_API_TOKEN=

# R2 S3 credentials scoped to Object Read & Write for ddtank-resource.
# Add these as encrypted secrets in ddtank-r2-deployer Workers Builds.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public custom domain or temporary r2.dev URL, without a trailing slash.
R2_PUBLIC_BASE_URL=

# images is the production default. Use full-resource only after reviewing a plan.
R2_PROFILE=images

# Workers Builds incremental uploader tuning.
R2_UPLOAD_CONCURRENCY=48
R2_HASH_CONCURRENCY=8
R2_CHECKPOINT_EVERY_FILES=5000
R2_VERIFY_SAMPLE_SIZE=256

# Non-main publishing is blocked unless explicitly enabled.
R2_ALLOW_NON_PRODUCTION=0

# Required only when remote-only object deletion is intentional.
R2_ALLOW_DELETE=0
